{
  "manifest_version": 3,
  "name": "FXT Team New Tab",
  "version": "1.5.4",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "manual-update.js"},
  "description": "Открывает FXT Team при создании новой вкладки Chrome.",
  "host_permissions": ["https://homepage.fxtteam.ru/*"],
  "content_scripts": [{
    "matches": ["https://homepage.fxtteam.ru/*", "http://localhost/*"],
    "js": ["installed.js"],
    "run_at": "document_idle"
  }],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FXT Team New Tab — обновления",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
