{
  "manifest_version": 3,
  "name": "FXT Team New Tab",
  "version": "1.5.0",
  "description": "Открывает FXT Team при создании новой вкладки Chrome.",
  "host_permissions": ["https://homepage.fxtteam.ru/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
